{
  "name": "@kestrel-it/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('drizzle', 'dist/drizzle', { recursive: true })\"",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "tsc -p tsconfig.build.json && drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.3.0",
    "@kestrel-it/shared": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.5",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.40.0",
    "jose": "^6.0.8",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.11",
    "@types/bcryptjs": "^2.4.6",
    "drizzle-kit": "^0.30.5"
  }
}
