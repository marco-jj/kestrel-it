{
  "name": "@kestrel-it/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('drizzle', 'dist/drizzle', { recursive: true })\"",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "tsc -p tsconfig.build.json && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "openapi:export": "tsc -p tsconfig.build.json && node dist/openapi/generate-openapi.js",
    "openapi:check": "tsc -p tsconfig.build.json && node dist/openapi/generate-openapi.js --check"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "@kestrel-it/shared": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.4.8",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.11.4",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.12.8",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.0.8",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.17.2",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx-stream-writer": "^1.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pngjs": "^6.0.5",
    "@zxing/library": "^0.23.0",
    "drizzle-kit": "^0.31.11",
    "read-excel-file": "^9.3.20"
  }
}
