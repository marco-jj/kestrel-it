{
  "name": "kestrel-it",
  "version": "0.1.0",
  "private": true,
  "description": "A modern, cloud-native IT Asset Management (ITAM) platform built with NestJS, Drizzle/PostgreSQL, Angular, OIDC, and Helm.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @kestrel-it/shared build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,js,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
